# AI Resume Builder - Environment Configuration

# Backend API Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon / PostgreSQL)
# Example Neon URL: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# Admin Authentication
JWT_SECRET=super_secret_jwt_key_development_only_change_in_production_12345
ADMIN_DEFAULT_EMAIL=admin@resumebuilder.local
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword2026!

# Google Gemini AI API Key (Server-side only)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage
UPLOAD_DIR=./uploads
