# Backend API Environment Variables (Render / Production)

# Server Binding
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Origin URL (Allowed CORS origins, comma-separated)
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon Serverless PostgreSQL)
# Example: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
# Local development fallback: file:./dev.db
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
ADMIN_DEFAULT_EMAIL=admin@resumebuilder.local
ADMIN_DEFAULT_PASSWORD=replace_with_a_strong_production_password

# Google Gemini AI API Key (Server-side only)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage
UPLOAD_DIR=./uploads

# Support & Mail Delivery Settings
SUPPORT_EMAIL=support.dvlpr@gmail.com
MAIL_FROM=CareerDoc AI <support.dvlpr@gmail.com>
# Optional SMTP configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=support.dvlpr@gmail.com
# SMTP_PASS=your_app_password_here

